{
    "name": "youvision/think-store-example",
    "description": "ThinkPHP 8 静态站点实例包，内置唐诗随机抽取路由接口，并通过 youvision/think-static 部署静态资源。",
    "type": "library",
    "version": "1.0.0",
    "license": "MIT",
    "keywords": [
        "thinkphp",
        "thinkphp8",
        "static",
        "assets",
        "store",
        "poem",
        "example"
    ],
    "authors": [
        {
            "name": "indiboy-create",
            "homepage": "https://github.com/indiboy-create"
        },
        {
            "name": "AI",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.0",
        "topthink/framework": "^8.0",
        "youvision/think-static": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Youvision\\ThinkStoreExample\\": "src/"
        }
    },
    "extra": {
        "think": {
            "services": [
                "Youvision\\ThinkStoreExample\\Service"
            ],
            "config": {
                "store_example": "config/store_example.php"
            }
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "@php tests/verify.php"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}