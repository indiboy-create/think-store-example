{
    "name": "youvision/think-store-example",
    "description": "ThinkPHP 8 示例包：包内视图渲染、layui 静态资源路由与随机抽诗接口。",
    "type": "library",
    "version": "1.0.0",
    "license": "MIT",
    "keywords": [
        "thinkphp",
        "thinkphp8",
        "store",
        "example",
        "view",
        "assets",
        "layui",
        "poem"
    ],
    "authors": [
        {
            "name": "indiboy-create",
            "homepage": "https://github.com/indiboy-create"
        },
        {
            "name": "AI",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.0",
        "topthink/framework": "^8.0",
        "topthink/think-view": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Youvision\\ThinkStoreExample\\": "src/"
        }
    },
    "extra": {
        "think": {
            "services": [
                "Youvision\\ThinkStoreExample\\Service"
            ],
            "config": {
                "store_example": "config/store_example.php"
            }
        },
        "store": {
            "home": "/store/think-store-example"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "@php tests/verify.php"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}